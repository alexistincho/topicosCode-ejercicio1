#--------------------------------------------------------------------
# Configuracion de entorno - MyCar (Practico Frameworks)
# Generado para correr sobre XAMPP
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Vacio = CodeIgniter detecta automaticamente la URL segun la carpeta
# donde se ubique el proyecto dentro de htdocs. No es necesario tocarlo
# salvo que quieras fijar una URL especifica.
app.baseURL = 'http://localhost/topicosCode-ejercicio1/public/'

#--------------------------------------------------------------------
# DATABASE (valores por defecto de XAMPP: usuario root, sin clave)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = mycar_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
